# Frontend only. Copy to .env.development and/or .env.production.
# Never put a Supabase secret key in a Vite environment file.

# Browser client (safe to expose)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional. Public origin used in WhatsApp/SMS invite links.
# Required on Vercel Production so invite links never use preview/localhost.
# VITE_PUBLIC_SITE_URL=https://your-production-domain.com
