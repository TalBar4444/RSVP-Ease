# Browser client (safe to expose — publishable / anon key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional. Public origin used in WhatsApp/SMS invite links.
# If unset, the current browser origin is used.
# VITE_PUBLIC_SITE_URL=https://your-production-domain.com

